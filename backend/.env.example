# Copy this file to ".env" in the same folder (backend/) and fill in your real values.

# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string.
# Get a free, permanent one from https://console.neon.tech/signup (no card needed).
# Copy the connection string shown on your Neon project's dashboard.
# It looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=your_neon_connection_string_here

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_string

# How the AI measures meaning:
#   local  = run the model on this computer (needs: pip install -r requirements-local.txt)
#   gemini = use Gemini's embeddings API (light, used on Render)
EMBEDDING_BACKEND=local

# Optional: rescale raw similarity so match percentages spread well.
# Get suggested values by running:  python calibrate.py sample_job.txt <folder of resumes>
# SIM_LOW=0.5
# SIM_HIGH=0.9
